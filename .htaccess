RewriteEngine On

RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://moimani.ai%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.moimani\.ai$ [NC]
RewriteRule ^ https://moimani.ai%{REQUEST_URI} [R=301,L]

RewriteCond %{THE_REQUEST} \s/+privacy\.html[\s?] [NC]
RewriteRule ^privacy\.html$ /privacy [R=301,L]
RewriteCond %{THE_REQUEST} \s/+cookie\.html[\s?] [NC]
RewriteRule ^cookie\.html$ /cookie [R=301,L]
RewriteCond %{THE_REQUEST} \s/+bezopasnost\.html[\s?] [NC]
RewriteRule ^bezopasnost\.html$ /bezopasnost [R=301,L]
RewriteRule ^pervye-1000(?:\.html)?$ /#early-access [R=301,NE,L]
RewriteCond %{THE_REQUEST} \s/+faq\.html[\s?] [NC]
RewriteRule ^faq\.html$ /faq [R=301,L]
RewriteCond %{THE_REQUEST} \s/+soglasie\.html[\s?] [NC]
RewriteRule ^soglasie\.html$ /soglasie [R=301,L]
RewriteRule ^data/ - [F,L]
RewriteRule ^api/waitlist/?$ /api/waitlist.php [L]
RewriteRule ^api/waitlist-stats/?$ /api/waitlist.php [L]
RewriteRule ^admin/waitlist/?$ /api/waitlist-admin.php [L]
RewriteRule ^privacy/?$ /privacy.html [L]
RewriteRule ^cookie/?$ /cookie.html [L]
RewriteRule ^bezopasnost/?$ /bezopasnost.html [L]
RewriteRule ^faq/?$ /faq.html [L]
RewriteRule ^soglasie/?$ /soglasie.html [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
