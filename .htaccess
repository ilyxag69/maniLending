RewriteEngine On
AddDefaultCharset UTF-8
ErrorDocument 404 /404.php

RewriteCond %{HTTP:Authorization} ^(.+)
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://moimani.ai%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.moimani\.ai$ [NC]
RewriteRule ^ https://moimani.ai%{REQUEST_URI} [R=301,L]

RewriteCond %{THE_REQUEST} \s/+privacy\.html[\s?] [NC]
RewriteRule ^privacy\.html$ /privacy [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+cookie\.html[\s?] [NC]
RewriteRule ^cookie\.html$ /cookie [R=301,L]
RewriteCond %{THE_REQUEST} \s/+bezopasnost\.html[\s?] [NC]
RewriteRule ^bezopasnost\.html$ /bezopasnost [R=301,L]
RewriteRule ^pervye-1000(?:\.html)?$ /#early-access [R=301,NE,L]
RewriteCond %{THE_REQUEST} \s/+faq\.html[\s?] [NC]
RewriteRule ^faq\.html$ /faq [R=301,L]
RewriteCond %{THE_REQUEST} \s/+bank-connection\.html[\s?] [NC]
RewriteRule ^bank-connection\.html$ /support/bank-connection [R=301,L]
RewriteCond %{THE_REQUEST} \s/+soglasie\.html[\s?] [NC]
RewriteRule ^soglasie\.html$ /soglasie [R=301,L]
RewriteCond %{THE_REQUEST} \s/+delete-account\.html[\s?] [NC]
RewriteRule ^delete-account\.html$ /delete-account [R=301,L]
RewriteRule ^consent(?:\.html)?$ /soglasie [R=301,L]
RewriteRule ^cookies(?:\.html)?$ /cookie [R=301,L]
RewriteRule ^data/ - [F,L]
RewriteRule ^api/waitlist/?$ /api/waitlist.php [L]
RewriteRule ^api/waitlist-stats/?$ /api/waitlist.php [L]
RewriteRule ^api/contact/?$ /api/contact.php [L]
RewriteRule ^api/analytics/?$ /api/analytics.php [L]
RewriteRule ^admin/analytics/?$ /api/analytics-admin.php [L]
RewriteRule ^admin/waitlist/?$ /api/waitlist-admin.php [L]
RewriteRule ^start/?$ /index.html [L]
RewriteRule ^privacy/?$ /privacy.html [L]
RewriteRule ^cookie/?$ /cookie.html [L]
RewriteRule ^bezopasnost/?$ /bezopasnost.html [L]
RewriteRule ^faq/?$ /faq.html [L]
RewriteRule ^support/bank-connection/?$ /bank-connection.html [L]
RewriteRule ^soglasie/?$ /soglasie.html [L]
RewriteRule ^delete-account/?$ /delete-account.html [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Frame-Options "DENY"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://mc.yandex.ru; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://mc.yandex.ru https://*.mc.yandex.ru"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Content-Type "text/html; charset=UTF-8"
  </FilesMatch>
  <Files "product-config.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  <FilesMatch "\.(?:woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddType font/woff2 .woff2

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
